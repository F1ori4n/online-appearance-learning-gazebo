<?xml version="1.0"?>
<sdf version="1.8">
  <world name="world_1">
    <scene>
      <grid>false</grid>
    </scene>
    <physics name="1ms" type="ignored">
      <max_step_size>0.003</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>200</real_time_update_rate>
    </physics>
    <plugin name="gz::sim::systems::Physics" filename="gz-sim-physics-system" />
    <plugin name="gz::sim::systems::UserCommands" filename="gz-sim-user-commands-system" />
    <plugin name="gz::sim::systems::SceneBroadcaster" filename="gz-sim-scene-broadcaster-system" />
    <plugin name="gz::sim::systems::Contact" filename="gz-sim-contact-system" />
    <!--<plugin name="gz::sim::systems::Sensors" filename="gz-sim-sensors-system">
        <render_engine>ogre2</render_engine>
    </plugin>-->

    
    <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
        <publish_model_pose>true</publish_model_pose>
        <publish_nested_model_pose>true</publish_nested_model_pose>

        <publish_link_pose>false</publish_link_pose>
        <publish_visual_pose>false</publish_visual_pose>
        <publish_collision_pose>false</publish_collision_pose>
        <publish_sensor_pose>false</publish_sensor_pose>

        <use_pose_vector_msg>true</use_pose_vector_msg>
        <update_frequency>30</update_frequency>
    </plugin>

    <include>
      <uri>
        ../models/depot
      </uri>
    </include>

    <!-- Extra collision for Depot crates -->
    <model name="depot_crates_collision">
    <static>true</static>
    <pose>0 0 0 0 0 0</pose>

    <link name="link">
        <collision name="collision">
        <geometry>
            <mesh>
            <scale>0.60 0.60 0.60</scale>
            <uri>../models/depot/meshes/Crates.dae</uri>
            </mesh>
        </geometry>
        </collision>
    </link>
    </model>


    <!-- Extra collision for Depot BOXSET submesh -->
    <model name="depot_boxset_collision">
    <static>true</static>
    <pose>0 0 0 0 0 0</pose>

    <link name="link">
        <collision name="collision">
        <geometry>
            <mesh>
            <scale>0.60 0.60 0.60</scale>
            <uri>../models/depot/meshes/Depot.dae</uri>
            <submesh>
                <name>BOXSET</name>
                <center>false</center>
            </submesh>
            </mesh>
        </geometry>
        </collision>
    </link>
    </model>

    <actor name="Remy">

      <pose>0 5.5 0.92 1.57 0 0</pose>

      <skin>
        <filename>../models/actors/Remy/meshes/character.dae</filename>
      </skin>

      <animation name="walk">
        <filename>../models/actors/Remy/meshes/character.dae</filename>
        <interpolate_x>true</interpolate_x>
      </animation>

      <script>
          <loop>true</loop>
          <delay_start>20</delay_start>
          <auto_start>true</auto_start>
          <trajectory id="0" type="walk">
              <!---y z x . yaw . -->
                <waypoint>
                    <time>0</time>
                    <pose>-4 0 -1 0 1.57 0</pose>
                </waypoint>
                <waypoint>
                    <time>10</time>
                    <pose>-1 0 -1 0 1.57 0</pose>
                </waypoint>
                <waypoint>
                    <time>12.5</time>
                    <pose>0 0 0 0 0 0</pose>
                </waypoint>
                <waypoint>
                    <time>20</time>
                    <pose>0 0 4 0 0 0</pose>
                </waypoint>
                <waypoint>
                    <time>22.5</time>
                    <pose>-1 0 5 0 -1.57 0</pose>
                </waypoint>
                <waypoint>
                    <time>25</time>
                    <pose>-2 0 5 0 -1.57 0</pose>
                </waypoint>
                <waypoint>
                    <time>27.5</time>
                    <pose>-3 0 6 0 0 0</pose>
                </waypoint>
                <waypoint>
                    <time>37.5</time>
                    <pose>-3 0 10 0 0 0</pose>
                </waypoint>
                <waypoint>
                    <time>45</time>
                    <pose>-1 0 12 0 1.57 0</pose>
                </waypoint>
                <waypoint>
                    <time>70</time>
                    <pose>9 0 12 0 1.57 0</pose>
                </waypoint>
                <waypoint>
                    <time>80</time>
                    <pose>10 0 10 0 3.14 0</pose>
                </waypoint>
                <waypoint>
                    <time>87.5</time>
                    <pose>10 0 7 0 3.14 0</pose>
                </waypoint>
                <waypoint>
                    <time>90</time>
                    <pose>11 0 6 0 1.57 0</pose>
                </waypoint>
                <waypoint>
                    <time>92.5</time>
                    <pose>12 0 5 0 3.14 0</pose>
                </waypoint>
                <waypoint>
                    <time>107.5</time>
                    <pose>11.5 0 0 0 3.93 0</pose>
                </waypoint>
                <waypoint>
                    <time>110</time>
                    <pose>9.5 0 -1 0 4.71 0</pose>
                </waypoint>
                <waypoint>
                    <time>112</time>
                    <pose>9 0 -1 0 4.71 0</pose>
                </waypoint>
                <waypoint>
                    <time>137</time>
                    <pose>0 0 -0.5 0 4.71 0</pose>
                </waypoint>
                <waypoint>
                    <time>162</time>
                    <pose>-11 0 -0.5 0 4.71 0</pose>
                </waypoint>
                <waypoint>
                    <time>167</time>
                    <pose>-13 0 0.5 0 6.18 0</pose>
                </waypoint>
                <waypoint>
                    <time>185</time>
                    <pose>-13 0 8 0 6.18 0</pose>
                </waypoint>
                <waypoint>
                    <time>230</time>
                    <pose>-13 0 8 0 6.18 0</pose>
                </waypoint>
          </trajectory>
      </script>
    </actor>
  </world>
</sdf>
